---
import BlogLayout from '../../../layouts/BlogLayout.astro';
import { getBlogPosts, taxonomyValues } from '../../../lib/blog';
const posts = await getBlogPosts();
const categories = taxonomyValues(posts, 'category');
---
<BlogLayout title="Categories | 손인창" headerTitle="Categories" description="대표 주제별로 글을 모아 봅니다.">
  <section class="panel taxonomy-directory">{categories.map((category) => <a href={`/blog/categories/${encodeURIComponent(category)}`}><strong>{category}</strong><span>{posts.filter((post) => post.data.category === category).length} posts</span></a>)}</section>
</BlogLayout>
