---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import SiteHeader from '../../../components/SiteHeader.astro';
import PostCard from '../../../components/PostCard.astro';
import { getBlogPosts, taxonomyValues } from '../../../lib/blog';
export async function getStaticPaths() {
  const posts = await getBlogPosts();
  return taxonomyValues(posts, 'tags').map((tag) => ({ params: { tag }, props: { tag, posts: posts.filter((post) => post.data.tags.includes(tag)) } }));
}
const { tag, posts } = Astro.props;
---
<BaseLayout title={`#${tag} | Tags`} description={`#${tag} 태그의 글`}><main class="page"><SiteHeader eyebrow="Tag" title={`#${tag}`} description={`${posts.length}개의 글`} /><section class="panel list">{posts.map((post) => <PostCard post={post} />)}</section></main></BaseLayout>
