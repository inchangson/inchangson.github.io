---
import BlogLayout from '../../../layouts/BlogLayout.astro';
import { getBlogPosts, taxonomyValues } from '../../../lib/blog';
const posts = await getBlogPosts();
const tags = taxonomyValues(posts, 'tags');
---
<BlogLayout title="Tags | 손인창" headerTitle="Tags" description="세부 주제별로 글을 모아 봅니다.">
  <section class="panel taxonomy-cloud">{tags.map((tag) => <a href={`/blog/tags/${encodeURIComponent(tag)}`}>#{tag} <span>{posts.filter((post) => post.data.tags.includes(tag)).length}</span></a>)}</section>
</BlogLayout>
