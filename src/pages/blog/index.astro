---
import BlogLayout from '../../layouts/BlogLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { getBlogPosts, taxonomyValues } from '../../lib/blog';

const posts = await getBlogPosts();
const categories = taxonomyValues(posts, 'category');
---

<BlogLayout title="Blog | 손인창" description="프로젝트 판단과 기술 선택을 글로 정리합니다.">
  <div class="category-groups">
    {categories.map((category) => <section class="panel category-group">
      <header class="category-group__header">
        <h2><a href={`/blog/categories/${encodeURIComponent(category)}`}>{category}</a></h2>
        <span>{posts.filter((post) => post.data.category === category).length} posts</span>
      </header>
      <div class="list">
        {posts.filter((post) => post.data.category === category).map((post) => <PostCard post={post} />)}
      </div>
    </section>)}
  </div>
</BlogLayout>
