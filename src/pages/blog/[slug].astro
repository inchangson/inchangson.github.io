---
import BlogLayout from '../../layouts/BlogLayout.astro';
import { getCollection, render } from 'astro:content';
import { bySeriesOrder, getBlogPosts } from '../../lib/blog';

export async function getStaticPaths() {
  const [posts, allSeries] = await Promise.all([getBlogPosts(), getCollection('series')]);
  const seriesById = new Map(allSeries.map((entry) => [entry.id, entry]));
  return posts.map((post) => {
    const siblings = post.data.series ? bySeriesOrder(posts.filter((item) => item.data.series === post.data.series)) : [];
    const position = siblings.findIndex((item) => item.id === post.id);
    return { params: { slug: post.id }, props: {
      post,
      series: post.data.series ? seriesById.get(post.data.series) : undefined,
      previous: position > 0 ? siblings[position - 1] : undefined,
      next: position >= 0 && position < siblings.length - 1 ? siblings[position + 1] : undefined,
    }};
  });
}

const { post, series, previous, next } = Astro.props;
const { Content } = await render(post);
---

<BlogLayout title={`${post.data.title} | 손인창`} description={post.data.description} showHero={false} activeCategory={post.data.category}>
    <article class="post">
      <header>
        <div class="post-taxonomy">
          <time>{post.data.pubDate.toLocaleDateString('ko-KR', { year: 'numeric', month: 'short', day: 'numeric' })}</time>
          {post.data.draft && <span class="draft-badge">Draft</span>}
          <a class="taxonomy-chip" href={`/blog/categories/${encodeURIComponent(post.data.category)}`}>{post.data.category}</a>
          {post.data.subcategory && <a class="taxonomy-chip taxonomy-chip--sub" href={`/blog/categories/${encodeURIComponent(post.data.category)}/${encodeURIComponent(post.data.subcategory)}`}>{post.data.subcategory}</a>}
          {post.data.tags.map((tag) => <a class="taxonomy-tag" href={`/blog/tags/${encodeURIComponent(tag)}`}>#{tag}</a>)}
        </div>
        <h1>{post.data.title}</h1>
        <p class="lede">{post.data.description}</p>
      </header>

      {series && <aside class="series-banner">
        <span>{post.data.seriesLabel || `${post.data.seriesOrder}편`}</span>
        <a href={`/blog/series/${series.id}`}>{series.data.title}</a>
      </aside>}
      <div class="post__content"><Content /></div>
      {series && <nav class="series-navigation" aria-label="시리즈 글 탐색">
        {previous ? <a href={`/blog/${previous.id}`}>← {previous.data.seriesLabel || previous.data.title}</a> : <span />}
        <a href={`/blog/series/${series.id}`}>시리즈 전체 보기</a>
        {next ? <a href={`/blog/${next.id}`}>{next.data.seriesLabel || next.data.title} →</a> : <span />}
      </nav>}
    </article>
</BlogLayout>

<script>
  import { renderMermaidCodeBlocks } from '../../lib/mermaid-client.js';

  void renderMermaidCodeBlocks(document.querySelector('.post__content')!, { scope: 'blog-post' });
</script>
