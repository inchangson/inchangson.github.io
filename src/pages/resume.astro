---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import resume from '../data/resume.json';
---

<BaseLayout title={`Resume | ${resume.profile.name}`} description={resume.profile.description}>
  <main class="page resume-page">
    <SiteHeader eyebrow={resume.profile.eyebrow} title={resume.profile.name} description={resume.profile.description} showNavigation={false} />

    {resume.sections.map((section, index) => {
      if (section.type === 'prose') return (
        <section class:list={[index === 0 ? 'resume-summary' : 'panel', 'stack']}>
          <div><h2>{section.title}</h2>{section.paragraphs?.map((paragraph) => <p>{paragraph}</p>)}</div>
          {index === 0 && resume.profile.contacts.length > 0 && (
            <address class="contact-list">{resume.profile.contacts.map((contact) => <a href={contact.url}>{contact.label}</a>)}</address>
          )}
        </section>
      );
      if (section.type === 'timeline') return (
        <section class="panel stack">
          <div><h2>{section.title}</h2>{section.note && <p class="section-note">{section.note}</p>}</div>
          {section.groups?.map((group) => (
            <div class="career-track">
              <header class="career-track__header"><div><h3>{group.title}</h3><p>{group.summary}</p></div><span>{group.period}</span></header>
              <div class="timeline">{group.items?.map((item) => (
                <article class="timeline-item">
                  <header><div><h4>{item.title}</h4><p>{item.summary}</p></div><span>{item.period}</span></header>
                  {item.highlights?.length > 0 && <ul>{item.highlights.map((highlight) => <li>{highlight}</li>)}</ul>}
                  {item.tech && <p class="tech-line">{item.tech}</p>}
                </article>
              ))}</div>
            </div>
          ))}
        </section>
      );
      if (section.type === 'list') return (
        <section class="panel stack">
          <div><h2>{section.title}</h2>{section.note && <p class="section-note">{section.note}</p>}</div>
          <ul>{section.items?.map((item) => <li>{item.title && <strong>{item.title}</strong>}{item.title && item.detail ? ', ' : ''}{item.detail}</li>)}</ul>
        </section>
      );
      return (
        <section class="panel stack">
          <div><h2>{section.title}</h2>{section.note && <p class="section-note">{section.note}</p>}</div>
          <div class="skill-table">{section.rows?.map((row) => <div><strong>{row.label}</strong><span>{row.value}</span></div>)}</div>
        </section>
      );
    })}
  </main>
</BaseLayout>
