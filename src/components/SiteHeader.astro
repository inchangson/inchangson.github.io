---
const {
  title,
  description,
  eyebrow = 'Backend Engineer',
  showNavigation = true,
  showHero = true,
} = Astro.props;
---

<header class="site-header">
  {showNavigation && (
    <div class="site-header__inner">
      <a class="brand" href="/">inchangson</a>
      <nav class="nav" aria-label="Primary">
        <a href="/blog">Blog</a>
      </nav>
    </div>
  )}
  {showHero && (
    <div class="hero">
      <p class="eyebrow">{eyebrow}</p>
      <h1>{title}</h1>
      <p class="lede">{description}</p>
    </div>
  )}
</header>
